# Optional. Every variable below has a default, so the service runs with no
# .env at all. To use one: copy to .env (.env is gitignored) and run with
#   uv run --env-file .env python -m ai_service
# (uv refuses --env-file when the file does not exist.) See
# ai_service/config.py for the authoritative schema. An invalid value stops
# the process at startup, naming the variable but never printing its value.

# development | test | production. The API docs (/docs, /redoc,
# /openapi.json) are served only in development.
APP_ENV=development
# Loopback by default: nothing but this machine can reach the service.
HOST=127.0.0.1
# apps/web is 3000, apps/commerce-api is 3001.
PORT=3002
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json | pretty ("pretty" is for local reading only)
LOG_FORMAT=json

# Deliberately absent: model-provider settings and keys, COMMERCE_API_BASE_URL,
# CORS origins, and any database URL. Nothing reads them yet, and this service
# must never have a database URL (docs/architecture/system-architecture.md
# section 4.1). Never commit a real secret here.
