# Optional. Every variable below has a default, so the service runs with no
# .env at all. To use one: copy to .env (.env is gitignored) and run with
#   uv run --env-file .env python -m ai_service
# (uv refuses --env-file when the file does not exist.) See
# ai_service/config.py for the authoritative schema. An invalid value stops
# the process at startup, naming the variable but never printing its value.

# development | test | production. The API docs (/docs, /redoc,
# /openapi.json) are served only in development.
APP_ENV=development
# Loopback by default: nothing but this machine can reach the service.
HOST=127.0.0.1
# apps/web is 3000, apps/commerce-api is 3001.
PORT=3002
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json | pretty ("pretty" is for local reading only)
LOG_FORMAT=json

# commerce-api's base URL: scheme, host and optional port only (no path,
# query, credentials or fragment). The only place the Commerce API client
# connects to; nothing a model says can change it. Defaults to
# http://127.0.0.1:3001 (the same name and default as apps/web) everywhere
# except APP_ENV=production, where it must be set.
COMMERCE_API_URL=http://127.0.0.1:3001
# Per-request timeout in seconds (connect, read, write, pool), 0.1-30.
# Requests are never retried.
COMMERCE_API_TIMEOUT_SECONDS=3.0

# A whole agent turn ends at this deadline with 504 AGENT_TIMEOUT (seconds,
# above 0 and at most 120). Keep it below apps/web's 30 s turn timeout.
AGENT_TURN_TIMEOUT_SECONDS=20
# Turns running at once in this process (1-1000). The next one is refused
# at once with 503 AGENT_BUSY. Per-client rate limits live at the reverse
# proxy.
AGENT_MAX_CONCURRENT_TURNS=16
# Comma-separated proxy addresses whose X-Forwarded-* headers are trusted.
# Empty (the default) trusts none.
FORWARDED_ALLOW_IPS=
# On SIGTERM, seconds in-flight requests get to finish (1-120).
SHUTDOWN_TIMEOUT_SECONDS=25

# Deliberately absent: model-provider settings and keys (Phase 14 still runs
# on a simulated model), CORS origins, and any database URL.
# Nothing reads them yet, and this service must never have a database URL
# (docs/architecture/system-architecture.md section 4.1). Never commit a real
# secret here.

# Refused: LangSmith/LangChain tracing would send customer messages to an
# external service. The service exits at startup if any of LANGSMITH_TRACING,
# LANGSMITH_TRACING_V2, LANGCHAIN_TRACING, LANGCHAIN_TRACING_V2 or
# LANGCHAIN_HANDLER is set to anything but "", "0", "false" or "False".
