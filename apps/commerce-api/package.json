{
  "name": "commerce-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/vite-node/vite-node.mjs --watch src/main.ts",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:up": "docker compose -f ../../infrastructure/docker/compose.yaml up -d --wait",
    "db:down": "docker compose -f ../../infrastructure/docker/compose.yaml down",
    "db:migrate": "node --env-file-if-exists=.env ./node_modules/vite-node/vite-node.mjs src/database/cli/migrate.ts",
    "db:migrate:down": "node --env-file-if-exists=.env ./node_modules/vite-node/vite-node.mjs src/database/cli/migrate.ts down",
    "db:seed": "node --env-file-if-exists=.env ./node_modules/vite-node/vite-node.mjs src/database/cli/seed.ts"
  },
  "dependencies": {
    "@contracts/api-contracts": "workspace:*",
    "@contracts/common": "workspace:*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@contracts/agent-intents": "workspace:*",
    "@nestjs/testing": "^12.1.0",
    "@standard-schema/spec": "^1.1.0",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vite": "^6.4.3",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  }
}
