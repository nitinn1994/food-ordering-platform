# Copy to .env for local development (.env is gitignored). See
# src/config/env.schema.ts for the authoritative schema. `dev`, `start` and
# the `db:*` scripts all load .env automatically via Node's
# --env-file-if-exists.

NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=log
LOG_FORMAT=json

# Required. Development-only credentials matching
# infrastructure/docker/compose.yaml (`pnpm --filter commerce-api db:up`) —
# not a secret. Never commit a real connection string.
DATABASE_URL=postgres://commerce:commerce@127.0.0.1:5432/commerce
# Optional, 1–50.
DATABASE_POOL_MAX=10

# Read only by the DB test suite (`pnpm --filter commerce-api test:db`), not
# by the application. Must name a database ending in "_test"; this is also
# the default the suite uses when unset.
TEST_DATABASE_URL=postgres://commerce:commerce@127.0.0.1:5432/commerce_test
