# Copy to .env for local development (.env is gitignored). Every value
# below is optional and shown here at its default — see
# src/config/env.schema.ts for the authoritative schema. `dev` and `start`
# both load .env automatically via Node's --env-file-if-exists.

NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=log
LOG_FORMAT=json
