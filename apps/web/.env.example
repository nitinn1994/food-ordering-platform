# Copy to .env.local for local development (.env* files are gitignored).
# See src/lib/api/config.ts and next.config.ts.

# Where commerce-api listens. Server-only — deliberately not NEXT_PUBLIC_:
# the browser calls this app's same-origin /api/commerce/v1/* path, which
# Next rewrites to this URL.
#
# Development: optional; defaults to commerce-api's own dev address below.
# Production: required, at build time (rewrites) and at runtime (Server
# Component fetches). Production deployment is not set up yet — placeholder.
COMMERCE_API_URL=http://127.0.0.1:3001

# Where ai-service listens (Phase 15). Server-only, like COMMERCE_API_URL:
# the browser calls this app's same-origin /api/ai/v1/agent/turns, which Next
# rewrites to this URL — that one path only.
#
# Development: optional; defaults to ai-service's own dev address below.
# Production: required at build time (rewrites). Placeholder, like above.
AI_SERVICE_URL=http://127.0.0.1:3002
