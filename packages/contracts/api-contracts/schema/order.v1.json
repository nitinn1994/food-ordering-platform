{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:food-ordering-platform:contracts:api-contracts:order:v1",
  "type": "object",
  "properties": {
    "orderId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "placed"
      ]
    },
    "placedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "customer": {
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "phone": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^\\+?[()-]*\\d(?:[\\s()-]*\\d){6,19}[()-]*$"
        },
        "email": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        }
      },
      "required": [
        "fullName",
        "phone"
      ],
      "additionalProperties": false
    },
    "items": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "unitPriceCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "lineSubtotalCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "itemId",
          "name",
          "unitPriceCents",
          "quantity",
          "lineSubtotalCents"
        ],
        "additionalProperties": false
      }
    },
    "itemCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "subtotalCents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "totalCents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "orderId",
    "status",
    "placedAt",
    "customer",
    "items",
    "itemCount",
    "subtotalCents",
    "totalCents"
  ],
  "additionalProperties": false
}
