{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:food-ordering-platform:contracts:api-contracts:cart-add-item-request:v1",
  "type": "object",
  "properties": {
    "itemId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    }
  },
  "required": [
    "itemId",
    "quantity"
  ],
  "additionalProperties": false
}
