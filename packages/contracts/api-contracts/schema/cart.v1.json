{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:food-ordering-platform:contracts:api-contracts:cart:v1",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "unitPriceCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "lineSubtotalCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "available": {
            "type": "boolean"
          }
        },
        "required": [
          "itemId",
          "name",
          "unitPriceCents",
          "quantity",
          "lineSubtotalCents",
          "available"
        ],
        "additionalProperties": false
      }
    },
    "itemCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "subtotalCents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "items",
    "itemCount",
    "subtotalCents"
  ],
  "additionalProperties": false
}
