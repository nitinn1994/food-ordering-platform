# Development env file for infrastructure/docker/compose.dev.yaml
# (docs/features/docker-environments/plan.md; reference:
# docs/operations/environment-variables.md). Every value here is a
# development-only placeholder, not a secret; the real .env.dev is
# git-ignored all the same.
#
#   cp infrastructure/docker/env/.env.dev.example infrastructure/docker/env/.env.dev
#   docker compose -f infrastructure/docker/compose.dev.yaml \
#     --env-file infrastructure/docker/env/.env.dev up -d --wait

# Keeps the dev stack's containers, networks and volumes apart from
# compose.yaml's database and from staging/prod.
COMPOSE_PROJECT_NAME=food-ordering-platform-dev

# --- Host ports (all bound to 127.0.0.1) -------------------------------------
# Change any that clash with something already running on the host, e.g. the
# host-run dev servers on 3000–3002.
WEB_PORT=3000
COMMERCE_API_PORT=3001
AI_SERVICE_PORT=3002
# 5433, not 5432, so it can run beside compose.yaml's database.
DEV_DB_PORT=5433

# --- File ownership ----------------------------------------------------------
# The apps run as this user so files they write into the mounted source stay
# yours. Set to the output of `id -u` and `id -g`.
DEV_UID=1000
DEV_GID=1000

# --- Database (dev container only) -------------------------------------------
# Dev placeholder; matches compose.yaml and apps/commerce-api/.env.example.
# Read when the dev volume is first created: after changing it, reset with
# `down -v`.
POSTGRES_PASSWORD=commerce
DATABASE_POOL_MAX=5

# --- Logging -----------------------------------------------------------------
# commerce-api: verbose | debug | log | warn | error | fatal
COMMERCE_LOG_LEVEL=debug
# ai-service: DEBUG | INFO | WARNING | ERROR | CRITICAL
AI_LOG_LEVEL=DEBUG
# json | pretty (both commerce-api and ai-service)
LOG_FORMAT=pretty

# --- ai-service limits -------------------------------------------------------
AGENT_TURN_TIMEOUT_SECONDS=20
AGENT_MAX_CONCURRENT_TURNS=4

# --- File watching -----------------------------------------------------------
# Polling, because Docker Desktop's file sharing (Linux, macOS, Windows)
# passes in-place writes into containers but not "atomic" saves (write a
# temp file, rename it over the original), which many editors use: without
# polling those edits are silently missed. On native Docker Engine on Linux,
# false (inotify) is enough and uses less CPU. web reads WATCHPACK_POLLING,
# commerce-api CHOKIDAR_USEPOLLING; ai-service's reloader always polls.
# commerce-api still misses rename-style saves on Docker Desktop even with
# polling: see compose.dev.yaml's commerce-api service.
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true
