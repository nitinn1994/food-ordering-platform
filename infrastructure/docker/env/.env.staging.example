# Staging env file for infrastructure/docker/compose.prod.yaml — the same
# compose file as prod, images built from the same commit, so staging tests
# what prod runs
# (docs/features/docker-environments/plan.md; reference:
# docs/operations/environment-variables.md; runbook:
# docs/operations/production-runbook.md, "Staging").
#
# This is a template: it holds no real secret. On the staging server, copy it
# OUTSIDE the repository, restrict it, and fill in every CHANGE_ME:
#
#   sudo install -D -m 0600 -o deploy infrastructure/docker/env/.env.staging.example \
#     /etc/fop/staging/compose.env
#   docker compose -f infrastructure/docker/compose.prod.yaml \
#     --env-file /etc/fop/staging/compose.env up -d --wait

# Keeps staging's containers, networks and volumes apart from prod's.
COMPOSE_PROJECT_NAME=food-ordering-platform-staging

# Image tag to run: the release candidate under test. Once it passes,
# deploy the same commit to prod (no registry yet: each host builds).
RELEASE_TAG=2026.10.02-rc1

# --- Database (its own managed PostgreSQL, never prod's) ---------------------
# SECRET. Generate the password with
#   openssl rand -hex 32
# (hex needs no URL-encoding; base64's / + = would). Do not add ?sslmode=
# here: DATABASE_SSL controls TLS, and commerce-api refuses both together.
DATABASE_URL=postgres://commerce_app:CHANGE_ME@staging-db.example.internal:5432/commerce_staging
# Same as prod, so certificate problems show up here first.
DATABASE_SSL=verify-full
# Staging carries little load and often a smaller database plan.
DATABASE_POOL_MAX=5

# --- Logging -----------------------------------------------------------------
# commerce-api: verbose | debug | log | warn | error | fatal
COMMERCE_LOG_LEVEL=debug
# ai-service: DEBUG | INFO | WARNING | ERROR | CRITICAL
AI_LOG_LEVEL=INFO

# --- ai-service limits -------------------------------------------------------
# Whole-turn deadline in seconds; keep it below web's 30 s turn timeout.
AGENT_TURN_TIMEOUT_SECONDS=20
# Turns running at once; the next is refused with 503 AGENT_BUSY.
AGENT_MAX_CONCURRENT_TURNS=8

# --- TLS ---------------------------------------------------------------------
# Host directory holding fullchain.pem and privkey.pem for the staging
# hostname (the key is secret: 0600, owned by root).
TLS_CERT_DIR=/etc/fop/staging/certs

# --- Smoke test only ---------------------------------------------------------
# Used only with `--profile local-db` (a throwaway PostgreSQL that does not
# keep data). Real staging uses its own managed database above; if you
# smoke-test, point DATABASE_URL at
# postgres://commerce:<this>@postgres:5432/commerce and use DATABASE_SSL=disable.
# LOCAL_DB_PASSWORD=CHANGE_ME
