# Production env file for infrastructure/docker/compose.prod.yaml
# (docs/features/docker-environments/plan.md; reference:
# docs/operations/environment-variables.md; runbook:
# docs/operations/production-runbook.md).
#
# This is a template: it holds no real secret. On the prod server, copy it
# OUTSIDE the repository, restrict it, and fill in every CHANGE_ME:
#
#   sudo install -D -m 0600 -o deploy infrastructure/docker/env/.env.prod.example \
#     /etc/fop/prod/compose.env
#   docker compose -f infrastructure/docker/compose.prod.yaml \
#     --env-file /etc/fop/prod/compose.env up -d --wait
#
# Staging uses the same compose file with .env.staging.example.

# Keeps prod's containers, networks and volumes apart from any other stack.
COMPOSE_PROJECT_NAME=food-ordering-platform-prod

# Image tag to run: the release promoted from staging. Never "latest", so a
# rollback is a tag change.
RELEASE_TAG=2026.10.02

# --- Database (managed PostgreSQL) -----------------------------------------
# SECRET. The app role's URL. Generate the password with
#   openssl rand -hex 32
# (hex needs no URL-encoding; base64's / + = would). Do not add ?sslmode=
# here: DATABASE_SSL controls TLS, and commerce-api refuses both together.
DATABASE_URL=postgres://commerce_app:CHANGE_ME@prod-db.example.internal:5432/commerce
# verify-full checks the server certificate. A provider with a private CA
# also needs NODE_EXTRA_CA_CERTS (runbook §2).
DATABASE_SSL=verify-full
# Connections per commerce-api instance (1–50). Keep it at or below the
# provider's connection limit divided by the number of instances.
DATABASE_POOL_MAX=10

# --- Logging -----------------------------------------------------------------
# commerce-api: verbose | debug | log | warn | error | fatal
COMMERCE_LOG_LEVEL=log
# ai-service: DEBUG | INFO | WARNING | ERROR | CRITICAL
AI_LOG_LEVEL=INFO

# --- ai-service limits -------------------------------------------------------
# Whole-turn deadline in seconds; keep it below web's 30 s turn timeout.
AGENT_TURN_TIMEOUT_SECONDS=20
# Turns running at once; the next is refused with 503 AGENT_BUSY.
AGENT_MAX_CONCURRENT_TURNS=16

# --- TLS ---------------------------------------------------------------------
# Host directory holding fullchain.pem and privkey.pem (the key is secret:
# 0600, owned by root), mounted read-only into the proxy.
TLS_CERT_DIR=/etc/fop/prod/certs

# --- Smoke test only ---------------------------------------------------------
# Used only with `--profile local-db` (a throwaway PostgreSQL). Never set in
# real prod; if you smoke-test, point DATABASE_URL at
# postgres://commerce:<this>@postgres:5432/commerce and use DATABASE_SSL=disable.
# LOCAL_DB_PASSWORD=CHANGE_ME
